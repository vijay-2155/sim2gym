# Copy to .env (gitignored) and fill in. Never commit real keys.
# OpenRouter (main backend; free models). Key is read server-side only, never logged or returned.
OPENROUTER_API_KEY=
# Bedrock (paid, short tests only) uses the local AWS CLI credentials; region override:
SIM2GYM_BEDROCK_REGION=us-east-1
# Set to 1 to lift the paid-model guard for the API / live demo (CLI uses --allow-paid instead).
SIM2GYM_ALLOW_PAID=
# Optional OpenAI-compatible local server (Ollama) for openai:<model>
SIM2GYM_BASE_URL=http://localhost:11434/v1
SIM2GYM_API_KEY=ollama
# Comma-separated extra openai:<model> names the API/demo may use, e.g. qwen3:4b
SIM2GYM_OPENAI_MODELS=
# Server data paths (API)
SIM2GYM_TASKS=tasks.jsonl
SIM2GYM_RESULTS=results
# Default model preselected in the live demo (must be in the allowlist), e.g. bedrock:qwen.qwen3-32b-v1:0
SIM2GYM_DEFAULT_MODEL=
